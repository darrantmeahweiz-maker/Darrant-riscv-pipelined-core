//prompt
/*Act as an expert RISC-V verification engineer and digital architect. I need you to generate an exhaustive, performance-optimized Verilog testbench instruction memory (IMEM) firmware initialization block (using r_Instruction assignments starting at 32'h00400000) designed specifically to stress-test and evaluate the performance of a sophisticated 5-stage RISC-V pipelined core featuring *Branch Prediction, a Pre-Decoder, a Deep Return Address Stack (RAS), and a Branch Monitor/Misprediction Recovery unit*.

You MUST write test instructions covering EVERY SINGLE MNEMONIC listed below, ensuring complete ISA coverage, proper ABI register usage (x0-x31), and rigorous verification of data hazards, control speculation, and execution performance metrics:

1. Arithmetic & Logic (Register) [10 instructions]: add, sub, sll, slt, sltu, xor, srl, sra, or, and
2. Arithmetic & Logic (Immediate) [9 instructions]: addi, slti, sltiu, xori, ori, andi, slli, srli, srai
3. Load Instructions [5 instructions]: lb, lh, lw, lbu, lhu
4. Store Instructions [3 instructions]: sb, sh, sw
5. Branch Instructions [6 instructions]: beq, bne, blt, bge, bltu, bgeu
6. Jump Instructions [2 instructions]: jal, jalr
7. Upper Immediate [2 instructions]: lui, auipc
8. System / Synchronization [3 instructions]: fence, ecall, ebreak
9. Multiplication Extension (Zmmul) [4 instructions]: mul, mulh, mulhsu, mulhu
10. Custom CRC Extension (Xicrc) [3 instructions]: crcb, crch, crcw
11. Bit Manipulation Extension (Zbb) [5 instructions]: clz, cpop, rev8, rol, ror

Specific Performance Optimization & Verification Requirements:
- *Tight Loop Branch Prediction Stress*: Wrap conditional branches (beq, bne, etc.) inside a multi-iteration execution loop (running 50 to 100 times) to thoroughly train the dynamic branch predictor, trigger adaptation phases, measure prediction hit/miss ratios, and evaluate misprediction penalty cycles.
- *Deep RAS Stress Testing (8+ Levels Deep)*: Implement a deep, multi-level nested function call hierarchy using jal (writing to ra/x1 or alternate link registers) and jalr pairs extending 8 or more levels deep. This will test the physical capacity, pointer management, and potential overflow/underflow handling of your hardware Return Address Stack.
- *Clock Cycle & IPC Measurement Markers*: Include dedicated register tracking markers or instruction sequences at the entry and exit of the performance-critical blocks. These can be monitored by the testbench to compute total clock cycles and Instructions Per Cycle (IPC) under different branch prediction configurations.
- *Data Forwarding & Load-Use Stalls*: Interleave dependent register streams to continuously test EX-to-EX and MEM-to-EX data forwarding paths, alongside load-use instruction pairs to verify 1-cycle pipeline interlock stalls.

Provide the output formatted cleanly as Verilog instruction memory lines (r_Instruction) starting at 32'h00400000, accompanied by a detailed block-by-block commentary mapping each section to its target instruction category, hazard type, branch prediction efficiency, or RAS depth level.
*/


// ============================================================================
// EXHAUSTIVE PIPELINE & PERFORMANCE VERIFICATION FIRMWARE
// Target: 5-Stage RISC-V Core with Dynamic Predictor, 8-Deep RAS, & Extensions
// ============================================================================
// Paste this into your IMEM.v or testbench initialization block.
// This firmware acts as a standalone bare-metal diagnostic and performance benchmark.

initial begin
    // ------------------------------------------------------------------------
    // BLOCK 1: IPC Start Marker, Upper Immediates & System Sync
    // Coverage: lui, auipc, fence, ecall, ebreak
    // ------------------------------------------------------------------------
    32'h00400000: r_Instruction = 32'h00001137; // [lui]    x2, 1        | Initialize base memory pointer
    32'h00400004: r_Instruction = 32'h00001197; // [auipc]  x3, 1        | IPC START MARKER: Record start time
    32'h00400008: r_Instruction = 32'h0ff0000f; // [fence]               | Pipeline sync
    32'h0040000C: r_Instruction = 32'h00000073; // [ecall]               | System trap test
    32'h00400010: r_Instruction = 32'h00100073; // [ebreak]              | Breakpoint evaluation
    
    // ------------------------------------------------------------------------
    // BLOCK 2: Base ALU & Heavy Data Hazard Forwarding Stress
    // Coverage: add, sub, sll, slt, sltu, xor, srl, sra, or, and
    // Coverage: addi, slti, sltiu, xori, ori, andi, slli, srli, srai
    // Mechanics: Cascading data dependencies to max-stress EX-to-EX and MEM-to-EX.
    // ------------------------------------------------------------------------
    32'h00400014: r_Instruction = 32'h06400213; // [addi]   x4, x0, 100  | Setup counter
    32'h00400018: r_Instruction = 32'h004202b3; // [add]    x5, x4, x4   | HAZARD: EX-to-EX (x4)
    32'h0040001C: r_Instruction = 32'h40428333; // [sub]    x6, x5, x4   | HAZARD: MEM-to-EX (x5), EX-to-EX (x4)
    32'h00400020: r_Instruction = 32'h00131393; // [slli]   x7, x6, 1
    32'h00400024: r_Instruction = 32'h00439433; // [sll]    x8, x7, x4
    32'h00400028: r_Instruction = 32'h06442493; // [slti]   x9, x8, 100
    32'h0040002C: r_Instruction = 32'h0084a533; // [slt]    x10, x9, x8
    32'h00400030: r_Instruction = 32'h06453593; // [sltiu]  x11, x10, 100
    32'h00400034: r_Instruction = 32'h0095b633; // [sltu]   x12, x11, x9
    32'h00400038: r_Instruction = 32'hfff64693; // [xori]   x13, x12, -1
    32'h0040003C: r_Instruction = 32'h00b6c733; // [xor]    x14, x13, x11
    32'h00400040: r_Instruction = 32'h00175793; // [srli]   x15, x14, 1
    32'h00400044: r_Instruction = 32'h00d7d833; // [srl]    x16, x15, x13
    32'h00400048: r_Instruction = 32'h40185893; // [srai]   x17, x16, 1
    32'h0040004C: r_Instruction = 32'h40d8d933; // [sra]    x18, x17, x13
    32'h00400050: r_Instruction = 32'h0ff96993; // [ori]    x19, x18, 255
    32'h00400054: r_Instruction = 32'h0129ea33; // [or]     x20, x19, x18
    32'h00400058: r_Instruction = 32'h0ffa7a93; // [andi]   x21, x20, 255
    32'h0040005C: r_Instruction = 32'h014afb33; // [and]    x22, x21, x20

    // ------------------------------------------------------------------------
    // BLOCK 3: Load/Store & 1-Cycle Pipeline Interlocks (Load-Use)
    // Coverage: sb, sh, sw, lb, lh, lw, lbu, lhu
    // Mechanics: Writes varying byte widths to DMEM, reads them, and intentionally 
    // triggers Load-Use stalls requiring the Hazard Unit to freeze IF/ID.
    // ------------------------------------------------------------------------
    32'h00400060: r_Instruction = 32'h01610023; // [sb]     x22, 0(x2)
    32'h00400064: r_Instruction = 32'h01611023; // [sh]     x22, 0(x2)
    32'h00400068: r_Instruction = 32'h01612023; // [sw]     x22, 0(x2)
    32'h0040006C: r_Instruction = 32'h00010b83; // [lb]     x23, 0(x2)
    32'h00400070: r_Instruction = 32'h00011c03; // [lh]     x24, 0(x2)
    32'h00400074: r_Instruction = 32'h00012c83; // [lw]     x25, 0(x2)
    32'h00400078: r_Instruction = 32'h019c8d33; // [add]    x26, x25, x25 | HAZARD: LOAD-USE STALL! Freezes PC & ID.
    32'h0040007C: r_Instruction = 32'h00014d83; // [lbu]    x27, 0(x2)
    32'h00400080: r_Instruction = 32'h00015e03; // [lhu]    x28, 0(x2)
    32'h00400084: r_Instruction = 32'h01cd8e33; // [add]    x28, x27, x28 | HAZARD: LOAD-USE STALL!

    // ------------------------------------------------------------------------
    // BLOCK 4: Zmmul, Xicrc, and Zbb Hardware Extensions
    // Coverage: mul, mulh, mulhsu, mulhu, crcb, crch, crcw, clz, cpop, rev8, rol, ror
    // Mechanics: Ensures `Pre_Decoder` and `Control_Unit` correctly route non-standard 
    // funct7/funct3 fields into custom execution units without corrupting Base ALU.
    // ------------------------------------------------------------------------
    // Zmmul Multipliers
    32'h00400088: r_Instruction = 32'h02428eb3; // [mul]    x29, x5, x4 
    32'h0040008C: r_Instruction = 32'h02429f33; // [mulh]   x30, x5, x4 
    32'h00400090: r_Instruction = 32'h0242afb3; // [mulhsu] x31, x5, x4 
    32'h00400094: r_Instruction = 32'h0242b0b3; // [mulhu]  x1,  x5, x4 
    // Xicrc Extension
    32'h00400098: r_Instruction = 32'h80428133; // [crcb]   x2, x5, x4
    32'h0040009C: r_Instruction = 32'h804291b3; // [crch]   x3, x5, x4
    32'h004000A0: r_Instruction = 32'h8042a233; // [crcw]   x4, x5, x4
    // Zbb Unary (Hardcoded rs2) & Binary
    32'h004000A4: r_Instruction = 32'h60029293; // [clz]    x5, x5      (rs2 = 00000)
    32'h004000A8: r_Instruction = 32'h60229313; // [cpop]   x6, x5      (rs2 = 00010)
    32'h004000AC: r_Instruction = 32'h6982d393; // [rev8]   x7, x5      (rs2 = 11000)
    32'h004000B0: r_Instruction = 32'h60429433; // [rol]    x8, x5, x4
    32'h004000B4: r_Instruction = 32'h6042d4b3; // [ror]    x9, x5, x4

    // ------------------------------------------------------------------------
    // BLOCK 5: Dynamic Branch Predictor Tight Loop (Performance Stress)
    // Coverage: beq, bne, blt, bge, bltu, bgeu
    // Mechanics: 50 Iterations. Tests predictor adaptation. The predictor should miss 
    // on iter 1, hit on iters 2-49, and mispredict on iter 50 (triggering recovery).
    // ------------------------------------------------------------------------
    32'h004000B8: r_Instruction = 32'h03200293; // [addi]   x5, x0, 50   | Loop limit
    32'h004000BC: r_Instruction = 32'h00000313; // [addi]   x6, x0, 0    | Loop iterator
    // --- Loop Start (0x004000C0) ---
    32'h004000C0: r_Instruction = 32'h00130313; // [addi]   x6, x6, 1
    32'h004000C4: r_Instruction = 32'h00530863; // [beq]    x6, x5, +16  | Bypass to Exit when done
    32'h004000C8: r_Instruction = 32'h00000013; // [nop]                 | Internal padding
    32'h004000CC: r_Instruction = 32'hfe531ae3; // [bne]    x6, x5, -12  | LOOP CONDITION
    // --- Loop Exit (0x004000D0) ---
    32'h004000D0: r_Instruction = 32'h00000013; // [nop]
    // Residual Branch Edge-Case Tests (Guaranteed Not Taken -> Should NOT Flush)
    32'h004000D4: r_Instruction = 32'h0062c463; // [blt]    x5, x6, +8   (50 < 50 is False)
    32'h004000D8: r_Instruction = 32'h00535463; // [bge]    x6, x5, +8   (50 >= 50 is True, skips next NOP)
    32'h004000DC: r_Instruction = 32'h00000013; // [nop]
    32'h004000E0: r_Instruction = 32'h0062e463; // [bltu]   x5, x6, +8   (False)
    32'h004000E4: r_Instruction = 32'h00537463; // [bgeu]   x6, x5, +8   (True)

    // ------------------------------------------------------------------------
    // BLOCK 6: Deep Return Address Stack (RAS) Stress Test (8 Levels Deep)
    // Coverage: jal, jalr
    // Mechanics: Evaluates physical capacity and pointer math of the 8-entry RAS. 
    // Every call pushes a return address; every jalr pops it perfectly without a stall.
    // ------------------------------------------------------------------------
    32'h004000E8: r_Instruction = 32'h00000013; // [nop]
    32'h004000EC: r_Instruction = 32'h018000ef; // [jal]    ra, -> L1_Call  (Push 1)
    32'h004000F0: r_Instruction = 32'h0440006f; // [jal]    x0, -> End_Test (Jump over functions)
    
    // Level 1
    32'h00400104: r_Instruction = 32'h00c000ef; // L1: [jal] ra, -> L2_Call (Push 2)
    32'h00400108: r_Instruction = 32'h00008067; //     [jalr] x0, ra, 0     (Pop 1)
    
    // Level 2
    32'h00400110: r_Instruction = 32'h00c000ef; // L2: [jal] ra, -> L3_Call (Push 3)
    32'h00400114: r_Instruction = 32'h00008067; //     [jalr] x0, ra, 0     (Pop 2)
    
    // Level 3 (Using Alternate Link Reg x5/t0)
    32'h0040011C: r_Instruction = 32'h00c002ef; // L3: [jal] x5, -> L4_Call (Push 4)
    32'h00400120: r_Instruction = 32'h00008067; //     [jalr] x0, ra, 0     (Pop 3)
    
    // Level 4
    32'h00400128: r_Instruction = 32'h00c000ef; // L4: [jal] ra, -> L5_Call (Push 5)
    32'h0040012C: r_Instruction = 32'h00028067; //     [jalr] x0, x5, 0     (Pop 4)

    // Level 5, 6, 7, 8 (Maxing Stack Depth)
    32'h00400134: r_Instruction = 32'h00c000ef; // L5: [jal] ra, -> L6_Call (Push 6)
    32'h00400138: r_Instruction = 32'h00008067; //     [jalr] x0, ra, 0     (Pop 5)
    
    32'h00400140: r_Instruction = 32'h00c000ef; // L6: [jal] ra, -> L7_Call (Push 7)
    32'h00400144: r_Instruction = 32'h00008067; //     [jalr] x0, ra, 0     (Pop 6)
    
    32'h0040014C: r_Instruction = 32'h00c000ef; // L7: [jal] ra, -> L8_Call (Push 8 - RAS MAXED)
    32'h00400150: r_Instruction = 32'h00008067; //     [jalr] x0, ra, 0     (Pop 7)

    // Level 8 (Deepest Leaf) - Misprediction Sabotage Test!
    // Mechanics: The RAS accurately predicts the return. We maliciously corrupt `ra`.
    // The Execution stage's Branch_Monitor MUST detect this, trigger a pipeline flush,
    // clear the speculatively fetched operations, and correct the PC.
    32'h00400158: r_Instruction = 32'h00000093; // L8: [addi] ra, x0, 0     | SABOTAGE! `ra` is now 0.
    32'h0040015C: r_Instruction = 32'h00008067; //     [jalr] x0, ra, 0     | RECOVERY TEST. RAS pops correct address. Actual jumps to 0.

    // ------------------------------------------------------------------------
    // BLOCK 7: IPC End Marker & Graceful Halt
    // Arrive here after L1 perfectly returns (Address 0x004000F4)
    // ------------------------------------------------------------------------
    32'h00400134: r_Instruction = 32'h00001217; // [auipc]  x4, 1        | IPC END MARKER: Simulation calculates total cycles vs instrs
    32'h00400138: r_Instruction = 32'h0000006f; // [jal]    x0, 0        | HALT. Infinite loop traps the PC safely.
end

