//this new architecture actively forces the processor into edge-case failure modes

// ============================================================================
// RISC-V 5-STAGE PIPELINE EXHAUSTIVE PERFORMANCE & STRESS FIRMWARE
// Address base: 0x0040_0000
// Coverage: RV32I, Zmmul, Xicrc, Zbb, Forwarding, Load-Use, Branch Saturation, RAS Overflow
// Status: x4 acts as the self-checking PASS (0x00) / FAIL (0xFFFFFFFF) flag.
// ============================================================================

initial begin
    // ============================================================================
    // BLOCK A — ABI/register setup + immediate ALU coverage
    // ============================================================================
    r_Instruction[32'h00400000] = 32'h00000213; // addi  x4,  x0,  0        // INIT PASS STATE (x4 = 0)
    r_Instruction[32'h00400004] = 32'h100101B7; // lui   x3, 0x10010        // Initialize GP (x3) to DMEM base
    r_Instruction[32'h00400008] = 32'h05A00E13; // addi  x28, x0,  90       // ENTRY marker (0x5A)
    r_Instruction[32'h0040000C] = 32'h01C1A823; // sw    x28, 16(x3)        // DMEM[0x10010010]
    r_Instruction[32'h00400010] = 32'h00700293; // addi  x5,  x0,  7
    r_Instruction[32'h00400014] = 32'h00300313; // addi  x6,  x0,  3
    r_Instruction[32'h00400018] = 32'h00200393; // addi  x7,  x0,  2
    r_Instruction[32'h0040001C] = 32'hFFB28413; // addi  x8,  x5, -5
    r_Instruction[32'h00400020] = 32'hFFF42493; // slti  x9,  x8, -1
    r_Instruction[32'h00400024] = 32'h00543513; // sltiu x10, x8,  5
    r_Instruction[32'h00400028] = 32'h05554593; // xori  x11, x10, 85
    r_Instruction[32'h0040002C] = 32'h0A55E613; // ori   x12, x11, 165
    r_Instruction[32'h00400030] = 32'h0F067693; // andi  x13, x12, 240
    r_Instruction[32'h00400034] = 32'h00369713; // slli  x14, x13, 3
    r_Instruction[32'h00400038] = 32'h00275793; // srli  x15, x14, 2
    r_Instruction[32'h0040003C] = 32'h40175813; // srai  x16, x14, 1

    // ============================================================================
    // BLOCK B — Register ALU forwarding chain
    // ============================================================================
    r_Instruction[32'h00400040] = 32'h006288B3; // add   x17, x5,  x6
    r_Instruction[32'h00400044] = 32'h40788933; // sub   x18, x17, x7
    r_Instruction[32'h00400048] = 32'h007919B3; // sll   x19, x18, x7
    r_Instruction[32'h0040004C] = 32'h01192A33; // slt   x20, x18, x17
    r_Instruction[32'h00400050] = 32'h0128BAB3; // sltu  x21, x17, x18
    r_Instruction[32'h00400054] = 32'h015A4B33; // xor   x22, x20, x21
    r_Instruction[32'h00400058] = 32'h007B5BB3; // srl   x23, x22, x7
    r_Instruction[32'h0040005C] = 32'h407B5C33; // sra   x24, x22, x7
    r_Instruction[32'h00400060] = 32'h018BECB3; // or    x25, x23, x24
    r_Instruction[32'h00400064] = 32'h016CFD33; // and   x26, x25, x22

    // SELF-CHECK 1: Confirm Forwarding Integrity
    r_Instruction[32'h00400068] = 32'h00A00E13; // addi  x28, x0, 10
    r_Instruction[32'h0040006C] = 32'h19C89663; // bne   x17, x28, FAIL_TRAP (+0x1B8)

    // ============================================================================
    // BLOCK C — Store/load/extension + explicit hazard sequences
    // ============================================================================
    r_Instruction[32'h00400070] = 32'h80FF8637; // lui   x12, 0x80FF8      
    r_Instruction[32'h00400074] = 32'hF0160613; // addi  x12, x12, -255    
    r_Instruction[32'h00400078] = 32'h00C1A023; // sw    x12, 0(x3)

    r_Instruction[32'h0040007C] = 32'h000086B7; // lui   x13, 0x00008      
    r_Instruction[32'h00400080] = 32'h00168693; // addi  x13, x13, 1       
    r_Instruction[32'h00400084] = 32'h00D19423; // sh    x13, 8(x3)

    r_Instruction[32'h00400088] = 32'h08000713; // addi  x14, x0, 128      
    r_Instruction[32'h0040008C] = 32'h00E18523; // sb    x14, 10(x3)

    r_Instruction[32'h00400090] = 32'h0001A783; // lw    x15, 0(x3)        // LOAD-USE source
    r_Instruction[32'h00400094] = 32'h00C78DB3; // add   x27, x15, x12      // HAZARD: Pipeline Stall

    r_Instruction[32'h00400098] = 32'h00819803; // lh    x16, 8(x3)
    r_Instruction[32'h0040009C] = 32'h00D84DB3; // xor   x27, x16, x13      
    r_Instruction[32'h004000A0] = 32'h0081D883; // lhu   x17, 8(x3)
    r_Instruction[32'h004000A4] = 32'h0108EDB3; // or    x27, x17, x16      
    r_Instruction[32'h004000A8] = 32'h00A18903; // lb    x18, 10(x3)
    r_Instruction[32'h004000AC] = 32'h00A1C983; // lbu   x19, 10(x3)
    r_Instruction[32'h004000B0] = 32'h01397DB3; // and   x27, x18, x19      

    // ============================================================================
    // BLOCK D — System/synchronization
    // ============================================================================
    r_Instruction[32'h004000B4] = 32'h0FF0000F; // fence
    r_Instruction[32'h004000B8] = 32'h00000073; // ecall
    r_Instruction[32'h004000BC] = 32'h00100073; // ebreak

    // ============================================================================
    // BLOCK E — Zmmul extension
    // ============================================================================
    r_Instruction[32'h004000C0] = 32'h80000A37; // lui   x20, 0x80000      
    r_Instruction[32'h004000C4] = 32'h00300A93; // addi  x21, x0, 3

    r_Instruction[32'h004000C8] = 32'h035A0B33; // mul   x22, x20, x21
    r_Instruction[32'h004000CC] = 32'h035A1BB3; // mulh  x23, x20, x21
    r_Instruction[32'h004000D0] = 32'h035A2C33; // mulhsu x24, x20, x21
    r_Instruction[32'h004000D4] = 32'h035A3CB3; // mulhu x25, x20, x21

    // ============================================================================
    // BLOCK F — Custom Xicrc extension
    // ============================================================================
    r_Instruction[32'h004000D8] = 32'h12300D13; // addi  x26, x0, 0x123
    r_Instruction[32'h004000DC] = 32'h815D0DB3; // crcb  x27, x26, x21
    r_Instruction[32'h004000E0] = 32'h815D1E33; // crch  x28, x26, x21
    r_Instruction[32'h004000E4] = 32'h815D2EB3; // crcw  x29, x26, x21

    // ============================================================================
    // BLOCK G — Zbb bit-manipulation extension
    // ============================================================================
    r_Instruction[32'h004000E8] = 32'h01234F37; // lui   x30, 0x01234
    r_Instruction[32'h004000EC] = 32'h567F0F13; // addi  x30, x30, 1383     
    r_Instruction[32'h004000F0] = 32'h600F1F93; // clz   x31, x30
    r_Instruction[32'h004000F4] = 32'h602F1E13; // cpop  x28, x30
    r_Instruction[32'h004000F8] = 32'h618F5E93; // rev8  x29, x30
    r_Instruction[32'h004000FC] = 32'h607E9F33; // rol   x30, x29, x7
    r_Instruction[32'h00400100] = 32'h607F5FB3; // ror   x31, x30, x7

    // ============================================================================
    // BLOCK H — AUIPC + non-RAS indirect JALR
    // ============================================================================
    r_Instruction[32'h00400104] = 32'h00000C17; // auipc x24, 0
    r_Instruction[32'h00400108] = 32'h010C0C13; // addi  x24, x24, 16
    r_Instruction[32'h0040010C] = 32'h000C0367; // jalr  x6, x24, 0         // rd=x6 => no RAS push
    r_Instruction[32'h00400110] = 32'h00c0006f; // jal  x0, +12             // return landing
    r_Instruction[32'h00400114] = 32'h00030E13; // addi  x28, x6, 0         // target body
    r_Instruction[32'h00400118] = 32'h00030067; // jalr  x0, x6, 0          // generic indirect return
    r_Instruction[32'h0040011C] = 32'h0B100E13; // addi  x28, x0, 177

    // ============================================================================
    // BLOCK I — Conditional branch predictor saturation training
    // ============================================================================
    r_Instruction[32'h00400120] = 32'h0B100E13; // addi  x28, x0, 177       // BRANCH START marker
    r_Instruction[32'h00400124] = 32'h01C1AC23; // sw    x28, 20(x3)        // DMEM[0x10010014]

    // BEQ
    r_Instruction[32'h00400128] = 32'h03C00C13; // addi  x24, x0, 60
    r_Instruction[32'h0040012C] = 32'hFFFC0C13; // addi  x24, x24, -1
    r_Instruction[32'h00400130] = 32'h000C0463; // beq   x24, x0, +8
    r_Instruction[32'h00400134] = 32'hFF9FF06F; // jal   x0, -8
    // BNE
    r_Instruction[32'h00400138] = 32'h03C00C13; // addi  x24, x0, 60
    r_Instruction[32'h0040013C] = 32'hFFFC0C13; // addi  x24, x24, -1
    r_Instruction[32'h00400140] = 32'hFE0C1EE3; // bne   x24, x0, -4
    // BLT
    r_Instruction[32'h00400144] = 32'h00000C13; // addi  x24, x0, 0
    r_Instruction[32'h00400148] = 32'h03C00C93; // addi  x25, x0, 60
    r_Instruction[32'h0040014C] = 32'h001C0C13; // addi  x24, x24, 1
    r_Instruction[32'h00400150] = 32'hFF9C4EE3; // blt   x24, x25, -4
    // BGE
    r_Instruction[32'h00400154] = 32'hFFFC0C13; // addi  x24, x24, -1
    r_Instruction[32'h00400158] = 32'hFE0C5EE3; // bge   x24, x0, -4
    // BLTU
    r_Instruction[32'h0040015C] = 32'h00000C13; // addi  x24, x0, 0
    r_Instruction[32'h00400160] = 32'h03C00C93; // addi  x25, x0, 60
    r_Instruction[32'h00400164] = 32'h001C0C13; // addi  x24, x24, 1
    r_Instruction[32'h00400168] = 32'hFF9C6EE3; // bltu  x24, x25, -4
    // BGEU
    r_Instruction[32'h0040016C] = 32'h00000C13; // addi  x24, x0, 0
    r_Instruction[32'h00400170] = 32'h03C00C93; // addi  x25, x0, 60
    r_Instruction[32'h00400174] = 32'h001C0C13; // addi  x24, x24, 1
    r_Instruction[32'h00400178] = 32'hFF8CFEE3; // bgeu  x25, x24, -4

    // ============================================================================
    // BLOCK J — RAS 9-Level Overflow Stress Test
    // ============================================================================
    r_Instruction[32'h0040017C] = 32'h0A800E13; // addi  x28, x0, 168       // RAS marker (0xA8)
    r_Instruction[32'h00400180] = 32'h01C1AC23; // sw    x28, 24(x3)        // DMEM[0x10010018]

    r_Instruction[32'h00400184] = 32'h014002EF; // jal   x5, ALT_CALL       // alternate RAS PUSH
    r_Instruction[32'h00400188] = 32'h00028E93; // addi  x29, x5, 0         // after alternate return

    r_Instruction[32'h0040018C] = 32'h014000EF; // jal   x1, RAS1           // depth 1 push
    r_Instruction[32'h00400190] = 32'h0D900F13; // addi  x30, x0, 217       // after 9-depth test
    r_Instruction[32'h00400194] = 32'h0940006F; // jal   x0, RAS_DONE       // skip function bodies

    // ---- ALT_CALL: x5 push/pop pair ----
    r_Instruction[32'h00400198] = 32'h00028F93; // addi  x31, x5, 0
    r_Instruction[32'h0040019C] = 32'h00028067; // jalr  x0, x5, 0          // RAS POP

    // ---- RAS1 / depth 1 ----
    r_Instruction[32'h004001A0] = 32'h00008413; // addi  x8,  x1, 0         // save link 1
    r_Instruction[32'h004001A4] = 32'h00C000EF; // jal   x1, RAS2
    r_Instruction[32'h004001A8] = 32'h00040093; // addi  x1,  x8, 0         // restore link 1
    r_Instruction[32'h004001AC] = 32'h00008067; // jalr  x0, x1, 0          // POP depth 1

    // ---- RAS2 / depth 2 ----
    r_Instruction[32'h004001B0] = 32'h00008493; // addi  x9,  x1, 0         
    r_Instruction[32'h004001B4] = 32'h00C000EF; // jal   x1, RAS3
    r_Instruction[32'h004001B8] = 32'h00048093; // addi  x1,  x9, 0         
    r_Instruction[32'h004001BC] = 32'h00008067; // jalr  x0, x1, 0          

    // ---- RAS3 / depth 3 ----
    r_Instruction[32'h004001C0] = 32'h00008913; // addi  x18, x1, 0         
    r_Instruction[32'h004001C4] = 32'h00C000EF; // jal   x1, RAS4
    r_Instruction[32'h004001C8] = 32'h00090093; // addi  x1, x18, 0         
    r_Instruction[32'h004001CC] = 32'h00008067; // jalr  x0, x1, 0          

    // ---- RAS4 / depth 4 ----
    r_Instruction[32'h004001D0] = 32'h00008993; // addi  x19, x1, 0         
    r_Instruction[32'h004001D4] = 32'h00C000EF; // jal   x1, RAS5
    r_Instruction[32'h004001D8] = 32'h00098093; // addi  x1, x19, 0         
    r_Instruction[32'h004001DC] = 32'h00008067; // jalr  x0, x1, 0          

    // ---- RAS5 / depth 5 ----
    r_Instruction[32'h004001E0] = 32'h00008A13; // addi  x20, x1, 0         
    r_Instruction[32'h004001E4] = 32'h00C000EF; // jal   x1, RAS6
    r_Instruction[32'h004001E8] = 32'h000A0093; // addi  x1, x20, 0         
    r_Instruction[32'h004001EC] = 32'h00008067; // jalr  x0, x1, 0          

    // ---- RAS6 / depth 6 ----
    r_Instruction[32'h004001F0] = 32'h00008A93; // addi  x21, x1, 0         
    r_Instruction[32'h004001F4] = 32'h00C000EF; // jal   x1, RAS7
    r_Instruction[32'h004001F8] = 32'h000A8093; // addi  x1, x21, 0         
    r_Instruction[32'h004001FC] = 32'h00008067; // jalr  x0, x1, 0          

    // ---- RAS7 / depth 7 ----
    r_Instruction[32'h00400200] = 32'h00008B13; // addi  x22, x1, 0         
    r_Instruction[32'h00400204] = 32'h00C000EF; // jal   x1, RAS8
    r_Instruction[32'h00400208] = 32'h000B0093; // addi  x1, x22, 0         
    r_Instruction[32'h0040020C] = 32'h00008067; // jalr  x0, x1, 0          

    // ---- RAS8 / depth 8 ----
    r_Instruction[32'h00400210] = 32'h00008B93; // addi  x23, x1, 0         
    r_Instruction[32'h00400214] = 32'h00C000EF; // jal   x1, RAS9           // depth 9 => overflow

    // ---- RAS9 / depth 9 ----
    r_Instruction[32'h00400218] = 32'h000B8093; // addi  x1, x23, 0         
    r_Instruction[32'h0040021C] = 32'h00008067; // jalr  x0, x1, 0          

    // ============================================================================
    // BLOCK K — Exit marker + terminal loop
    // ============================================================================
    // RAS_DONE
    r_Instruction[32'h00400220] = 32'h05F00E93; // addi  x29, x0, 95        // EXIT marker (0x5F)
    r_Instruction[32'h00400224] = 32'h01D1AE23; // sw    x29, 28(x3)        // DMEM[0x1001001C]
    r_Instruction[32'h00400228] = 32'h00C0006F; // jal   x0, +12             // Jumps to PASS

    // FAIL_TRAP (0x0040022C)
    r_Instruction[32'h0040022C] = 32'hFFF00213; // addi  x4, x0, -1         // SET x4 = 0xFFFFFFFF (FAIL)
    r_Instruction[32'h00400230] = 32'h0000006F; // jal   x0, 0              // Infinite Halt (Failure Mode)

    // PASS_TRAP (0x00400234)
    r_Instruction[32'h00400234] = 32'h0000006F; // jal   x0, 0              // Infinite Halt (Success Mode - x4 is still 0)
end

//r_Instruction[32'h00400228] = 32'h0080006F; // jal   x0, +8  
//You have just discovered one of the most notorious traps in pipelined processor design: The Ghost Fetch.
//At 0x228, the Fetch stage pulls the final jal instruction.
//In the very next clock cycle, the jump moves into Decode/Execute. Because your 5-stage pipeline has no branch delay slots and doesn't know it's a jump yet, the Fetch stage blindly grabs the next sequential instruction at 0x22C.
//The Kill-Switch Trigger: The testbench monitors the dut.PCF wire. It saw 0x22C appear in the Fetch stage and instantly panicked, throwing the ❌ TEST FAILED! flag and killing the simulation!
//If the testbench had waited just one more clock cycle, your Hazard_Unit would have asserted FlushD, wiped 0x22C out of the pipeline, and safely redirected the PC.
//To make matters slightly worse, the hex code for the jump at 0x228 was 0080006F (jal x0, +8). That would have landed the PC at 0x230—which is the infinite halt inside the fail trap! It needs to be +12 to safely land on the PASS trap at 0x234.


start
